# Preview mode — committed on purpose. NO REAL CREDENTIALS ARE IN THIS FILE.
#
# `npm run dev:preview` loads this and swaps the Storefront API for a local
# stand-in (src/lib/dev/shopifyMock.js), so the storefront runs on a machine
# that has no .env.local. Products, collections and variants are placeholders;
# cart and checkout are inert because they need the real API.
#
# For the real catalogue, put your Shopify keys in .env.local and use
# `npm run dev` instead.
VITE_MOCK_SHOPIFY=1

# Placeholder values. The Storefront client validates the API version string at
# construction, so it must be well-formed even though no request reaches it.
VITE_SHOPIFY_STORE_DOMAIN=preview.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=0000000000000000000000000000
VITE_SHOPIFY_API_VERSION=2026-07
