# Copy this file to `.env.local` and fill in real values.
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored (via `*.local`) and must never be committed.
# Vite inlines every VITE_* variable at BUILD time, so these must exist on the
# machine that runs `npm run build` — locally, and in your Vercel project
# settings for deploys. They are not read at runtime.
#
# No keys to hand? `npm run dev:preview` runs the whole storefront against a
# local stand-in with placeholder artwork. Cart and checkout are inert there.
#
# Check what you have without printing any secrets:  npm run check:env


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — without these the catalogue cannot load
# ─────────────────────────────────────────────────────────────────────────────

# Your myshopify domain, WITHOUT the https:// prefix (the code adds it).
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify admin → Settings → Apps and sales channels → Develop apps →
# your app → API credentials → Storefront API access token.
# This token is PUBLIC by design: it is meant to ship in client-side code, and
# it only grants the scopes you enabled. It still does not belong in git.
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token

# Must be a version Shopify still supports, e.g. 2026-07. An invalid or empty
# value used to blank the whole site; it now degrades to a readable error.
VITE_SHOPIFY_API_VERSION=2026-07


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED FOR ACCOUNTS — login, register, order history, wishlist sync
# Firebase console → Project settings → General → Your apps → SDK setup.
# Browsing and buying work without these; only the account area degrades.
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — each feature simply switches off when its variable is unset
# ─────────────────────────────────────────────────────────────────────────────

# Backend endpoint that mints a Shopify customer token. Unset = no customer
# sync, so the wishlist stays local to the browser instead of syncing.
VITE_SHOPIFY_CUSTOMER_SYNC_ENDPOINT=

# Address autocomplete at checkout (src/hooks/useGoogleMaps.js).
# Restrict this key by HTTP referrer to your domain and localhost.
VITE_GOOGLE_MAPS_API_KEY=

# GA4 measurement id. Analytics loads only when this is set AND the visitor
# has accepted cookies.
VITE_GA_MEASUREMENT_ID=


# ─────────────────────────────────────────────────────────────────────────────
# NOT USED. The Base44 variables that were previously listed here are read by
# no code in this repository — `src/api/base44Client.js` does not exist. They
# are removed rather than carried forward, so nobody fills them in expecting
# the site to start.
# ─────────────────────────────────────────────────────────────────────────────
